# ── API Base URL ───────────────────────────────────────────────────────────────
# Point to your local backend during development.
# When deploying to production, change this to the real hosted API URL.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# VITE_API_BASE_URL=http://10.1.118.176:8000/api
# VITE_API_BASE_URL=http://192.168.0.155:8000/api

# ── Mock API Toggle ────────────────────────────────────────────────────────────
# Set to "true"  → all modules use local mock data (no backend needed)
# Set to "false" → all modules call the real API at VITE_API_BASE_URL
# You can also override per-module — see src/services/core/apiConfig.js
VITE_USE_MOCK_API=false

# ── Request Timeout ────────────────────────────────────────────────────────────
VITE_API_TIMEOUT_MS=10000

VITE_GOOGLE_CLIENT_ID=436765791438-5lf3n8jigq6t0v0mnj0t7hoc5p4j5q0o.apps.googleusercontent.com
